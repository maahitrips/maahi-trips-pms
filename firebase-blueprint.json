{
  "entities": {
    "Hotel": {
      "title": "Hotel",
      "description": "Hotel property record in the multi-hotel portfolio",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique hotel identifier"
        },
        "name": {
          "type": "string",
          "description": "Display name of hotel"
        },
        "city": {
          "type": "string",
          "description": "City location"
        },
        "totalRooms": {
          "type": "number",
          "description": "Total room count"
        },
        "activeBookings": {
          "type": "number",
          "description": "Active bookings count"
        },
        "todayOccupancy": {
          "type": "number",
          "description": "Today occupancy percentage"
        },
        "ownerId": {
          "type": "string",
          "description": "Assigned property owner user ID"
        }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "User account for hotel staff, property owners, and super admins",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user account ID"
        },
        "name": {
          "type": "string",
          "description": "Full name"
        },
        "username": {
          "type": "string",
          "description": "Unique login username"
        },
        "role": {
          "type": "string",
          "description": "Access role (super_admin, hotel_owner, staff)"
        },
        "hotelId": {
          "type": "string",
          "description": "Associated hotel ID or all"
        }
      },
      "required": ["id", "username", "role"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Super admin approval request for room or property deletion",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Request unique ID"
        },
        "targetType": {
          "type": "string",
          "description": "Target type: room or hotel"
        },
        "targetId": {
          "type": "string",
          "description": "ID of item to delete"
        },
        "status": {
          "type": "string",
          "description": "Status: pending, approved, rejected"
        }
      },
      "required": ["id", "targetType", "targetId", "status"]
    },
    "HotelBundle": {
      "title": "HotelBundle",
      "description": "Complete bundle of rooms, bookings, profiles, and sync logs for a hotel",
      "type": "object",
      "properties": {
        "hotelId": {
          "type": "string",
          "description": "Hotel ID corresponding to this bundle"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp string of last sync update"
        }
      },
      "required": ["hotelId"]
    }
  },
  "firestore": {
    "/hotels/{hotelId}": {
      "schema": "Hotel",
      "description": "Hotels multi-tenant registry collection"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and permissions collection"
    },
    "/deletionRequests/{requestId}": {
      "schema": "DeletionRequest",
      "description": "Pending and resolved deletion authorization requests"
    },
    "/hotelBundles/{hotelId}": {
      "schema": "HotelBundle",
      "description": "Real-time synchronized hotel data bundle containing rooms, bookings, folios, and OTA configs"
    }
  }
}
