rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hotels multi-property registry
    match /hotels/{hotelId} {
      allow read, write: if true;
    }

    // User accounts and roles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deletion requests for admin approval
    match /deletionRequests/{requestId} {
      allow read, write: if true;
    }

    // Live hotel inventory, bookings, KYC IDs, and rate configurations + subcollections
    match /hotelBundles/{hotelId}/{document=**} {
      allow read, write: if true;
    }

    match /hotelBundles/{hotelId} {
      allow read, write: if true;
    }

    // Individual live bookings collection for instant multi-device sync
    match /liveBookings/{bookingId} {
      allow read, write: if true;
    }

    // Connection health test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback for all app documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
