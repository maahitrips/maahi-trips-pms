rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public slug lookup mapping
    match /hotelSlugs/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Hotels registry
    match /hotels/{hotelId} {
      allow read, write: if true;
    }

    // Hotel bundles: public availability & public hotel info read, bookings managed by backend API & staff
    match /hotelBundles/{hotelId} {
      allow read: if true;
      allow write: if true;
    }

    match /hotelBundles/{hotelId}/liveBookings/{bookingId} {
      allow read, write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deletion requests
    match /deletionRequests/{requestId} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
