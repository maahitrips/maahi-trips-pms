rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public slug lookup mapping
    match /hotelSlugs/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Hotels registry metadata
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if true;
    }

    // Hotel bundles: public read allowed ONLY if isPublished == true
    match /hotelBundles/{hotelId} {
      allow read: if resource.data.profile.isPublished == true || resource.data.isPublished == true;
      allow update, create, delete: if true;
    }

    // Live bookings subcollection: public create allowed ONLY with status 'Pending' and source 'Direct' or 'Direct (Website)'
    match /hotelBundles/{hotelId}/liveBookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'Pending' && (request.resource.data.source == 'Direct' || request.resource.data.source == 'Direct (Website)');
      allow update, delete: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deletion requests
    match /deletionRequests/{requestId} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
